# Telegram-Finance-Bot V2: non-secret settings example (staging).
# PLACEHOLDERS ONLY. Never put secret values in this file or in any committed env file.
# Secrets are provided as files (Docker secrets) via the *_FILE variables below; in
# staging/production/drill plaintext secret variables are rejected at startup (G-ENV-5).
# V2 reads only FINBOT_* variables and never loads .env files implicitly; this file is
# referenced explicitly by compose (Phase 1 Step 5) via `env_file:`.

FINBOT_ENV=staging
FINBOT_LOG_LEVEL=INFO
FINBOT_DEFAULT_TIMEZONE=Asia/Jakarta

# Database (must equal finbot_<env>; production uses finbot_prod) - G-ENV-2
FINBOT_DB_HOST=postgres
FINBOT_DB_PORT=5432
FINBOT_DB_NAME=finbot_staging
FINBOT_DB_APP_USER=finbot_app
FINBOT_DB_APP_PASSWORD_FILE=/run/secrets/db_app_password

# Telegram: the staging bot is a separate bot from production and from V1 (D18)
FINBOT_TELEGRAM_TOKEN_FILE=/run/secrets/telegram_token
FINBOT_TELEGRAM_EXPECTED_BOT_USERNAME=your_staging_bot_username_bot

# Gemini (only needed when FINBOT_AI_ENABLED=true; Phase 4)
# FINBOT_GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Feature flags
FINBOT_AI_ENABLED=false
FINBOT_RECEIPTS_ENABLED=false
FINBOT_EXPORT_ENABLED=false
FINBOT_INVITES_ENABLED=false
